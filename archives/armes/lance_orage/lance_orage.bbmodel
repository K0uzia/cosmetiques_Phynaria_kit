:"scale","data_points":[{"x":"1.35","y":"1.35","z":"1.35"}],"time":0.4}]}}}],"phynaria_sounds":{"eclair_lance":"data:audio/ogg;base64,"},"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"Lance d'orage","ensemble":"Orage","rarete":"rare","description":"Lance \u00e0 une main en m\u00e9tal d'orage, gain\u00e9e de cuir bleu nuit et d'or, au fer de cristal d'orage translucide travers\u00e9 d'un filet d'\u00e9clair ; des d\u00e9charges courent sur le fer et l'\u00e9clair jaillit au moment du coup.","lore":"Son fer est un morceau de cristal d'orage qui a d\u00e9j\u00e0 gard\u00e9 un \u00e9clair captif pendant cent ans. Elle se tient d'une main, toujours point\u00e9e vers le ciel au repos, pour que la foudre sache o\u00f9 revenir."},"particules":{"etincelle":{"quand":"toujours","nombre":6,"duree":1,"mouvement":"monte","au_sol":"pose","rendu":"translucide","sens":"camera","fin_de_vie":"retrecit","depart":"rapide","dispersion":180,"elan":100,"variation":"forte","rafale":"attaque","limite":64}}}}}