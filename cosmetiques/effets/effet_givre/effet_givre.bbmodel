}]},"d236b9e9-09a0-4e3e-9ecb-e2eed6f37b8d":{"name":"tourne_brume","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":"0.0","y":"q.anim_time*-15.0","z":"0.0"}],"time":0}]}}},{"uuid":"4032a7b9-704c-4f24-a1c6-94c0922f5132","name":"particle_flocon_fall","loop":"loop","override":false,"length":2.0,"snapping":24,"selected":false,"animators":{"5da4863b-5a27-4088-b7dc-7e77148aedfa":{"name":"particle_flocon","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"0.0"}],"time":0.0},{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"360.0"}],"time":2.0}]}}},{"uuid":"a0c3d1b2-0029-437b-b106-efad6ffafc5b","name":"particle_eclat_fall","loop":"loop","override":false,"length":0.8,"snapping":24,"selected":false,"animators":{"b9115fb9-d16e-48c5-8eaa-62d5446a9806":{"name":"particle_eclat","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"0.0"}],"time":0.0},{"channel":"rotation","data_points":[{"x":"360.0","y":"720.0","z":"0.0"}],"time":0.8}]}}},{"uuid":"cc46c88a-a479-425a-9b26-e99c46afcab9","name":"particle_poudre_fall","loop":"loop","override":false,"length":0.5,"snapping":24,"selected":false,"animators":{"62170099-060b-44c3-8b04-ebf90d16a62d":{"name":"particle_poudre","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"0.0"}],"time":0.0},{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"360.0"}],"time":0.5},{"channel":"scale","data_points":[{"x":"1.0","y":"1.0","z":"1.0"}],"time":0.0},{"channel":"scale","data_points":[{"x":"1.25","y":"1.25","z":"1.25"}],"time":0.062},{"channel":"scale","data_points":[{"x":"1.7","y":"1.7","z":"1.7"}],"time":0.125},{"channel":"scale","data_points":[{"x":"1.25","y":"1.25","z":"1.25"}],"time":0.188},{"channel":"scale","data_points":[{"x":"1.0","y":"1.0","z":"1.0"}],"time":0.25},{"channel":"scale","data_points":[{"x":"1.0","y":"1.0","z":"1.0"}],"time":0.5}]}}}],"phynaria_sounds":{"givre_forme":"data:audio/ogg;base64,","givre_eclate":"data:audio/ogg;base64,"},"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"Temp\u00eate de givre","ensemble":"Givre","rarete":"legendaire","description":"Un cercle de givre s'allume sous vos pieds. Au d\u00e9part, un cristal inclin\u00e9 jaillit du sol, vous fige dans la glace, se fend et vole en \u00e9clats. \u00c0 l'arriv\u00e9e, une gerbe de cristaux explose autour de vous, puis se dissout en poussi\u00e8re de givre.","lore":"Les gardiens du C\u0153ur d'Hiver ne marchent pas sur les longues routes : ils confient leur corps \u00e0 la glace. Le froid les fige d'un souffle, les brise en mille \u00e9clats, puis les fait rena\u00eetre ailleurs, l\u00e0 o\u00f9 le givre a trac\u00e9 son cercle. On dit qu'il faut ne jamais avoir peur du froid pour en revenir entier."},"particules":{"eclat":{"quand":"toujours","nombre":10,"duree":3,"mouvement":"lourde","au_sol":"disparait","rendu":"translucide","sens":"libre","fin_de_vie":"retrecit","depart":"rapide","dispersion":45,"elan":100,"variation":"forte","rafale":"aucune","limite":128},"flocon":{"quand":"toujours","nombre":6,"duree":3,"mouvement":"monte","au_sol":"pose","rendu":"translucide","sens":"camera","fin_de_vie":"fondu","depart":"moyen","dispersion":45,"elan":100,"variation":"forte","rafale":"aucune","limite":128},"mc_dust_bfeaff_12":{"quand":"toujours","nombre":6,"depart":"lent","dispersion":45,"rafale":"aucune","limite":128},"mc_item_snowball":{"quand":"toujours","nombre":6,"depart":"moyen","dispersion":45,"rafale":"aucune","limite":128},"mc_poof":{"quand":"toujours","nombre":4,"depart":"poussee","dispersion":180,"rafale":"aucune","limite":64},"mc_snowflake":{"quand":"toujours","nombre":6,"depart":"moyen","dispersion":180,"rafale":"aucune","limite":128},"poudre":{"quand":"toujours","nombre":10,"duree":3,"mouvement":"monte","au_sol":"pose","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"lent","dispersion":180,"elan":100,"variation":"forte","rafale":"aucune","limite":128}}}}}