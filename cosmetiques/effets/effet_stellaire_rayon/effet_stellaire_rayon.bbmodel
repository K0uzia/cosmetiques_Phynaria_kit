b8b-4bd4-91d6-a66fc8b81c49":{"name":"particle_eclat","type":"bone","keyframes":[{"channel":"scale","data_points":[{"x":"1.0","y":"1.0","z":"1.0"}],"time":0.0},{"channel":"scale","data_points":[{"x":"1.2475","y":"1.2475","z":"1.2475"}],"time":0.05},{"channel":"scale","data_points":[{"x":"1.35","y":"1.35","z":"1.35"}],"time":0.1},{"channel":"scale","data_points":[{"x":"1.2475","y":"1.2475","z":"1.2475"}],"time":0.15},{"channel":"scale","data_points":[{"x":"0.7525","y":"0.7525","z":"0.7525"}],"time":0.25},{"channel":"scale","data_points":[{"x":"0.65","y":"0.65","z":"0.65"}],"time":0.3},{"channel":"scale","data_points":[{"x":"0.7525","y":"0.7525","z":"0.7525"}],"time":0.35},{"channel":"scale","data_points":[{"x":"1.0","y":"1.0","z":"1.0"}],"time":0.4}]}}},{"uuid":"5f218d1a-21ff-4281-b3c3-96bfaa288cb6","name":"particle_strie_fall","loop":"loop","override":false,"length":0.5,"snapping":30,"selected":false,"animators":{"b3f2fd18-6523-479e-90a7-30f909546d3b":{"name":"particle_strie","type":"bone","keyframes":[{"channel":"scale","data_points":[{"x":"1.0","y":"1.0","z":"1.0"}],"time":0.0},{"channel":"scale","data_points":[{"x":"1.0","y":"1.2121","z":"1.0"}],"time":0.062},{"channel":"scale","data_points":[{"x":"1.0","y":"1.3","z":"1.0"}],"time":0.125},{"channel":"scale","data_points":[{"x":"1.0","y":"1.2121","z":"1.0"}],"time":0.188},{"channel":"scale","data_points":[{"x":"1.0","y":"0.7879","z":"1.0"}],"time":0.312},{"channel":"scale","data_points":[{"x":"1.0","y":"0.7","z":"1.0"}],"time":0.375},{"channel":"scale","data_points":[{"x":"1.0","y":"0.7879","z":"1.0"}],"time":0.438},{"channel":"scale","data_points":[{"x":"1.0","y":"1.0","z":"1.0"}],"time":0.5}]}}}],"phynaria_sounds":{"stellaire_rayon_eclair":"data:audio/ogg;base64,","stellaire_rayon_montee":"data:audio/ogg;base64,","stellaire_rayon_extinction":"data:audio/ogg;base64,"},"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"Rayon de t\u00e9l\u00e9portation","ensemble":"Stellaire","rarete":"legendaire","description":"Une lueur gr\u00e9sille autour de vous ; au d\u00e9part, une colonne de lumi\u00e8re tombe du ciel et votre corps se d\u00e9fait en \u00e9clats qui montent dans le faisceau. \u00c0 l'arriv\u00e9e, les \u00e9clats redescendent et vous reconstruisent de bas en haut.","lore":"Les b\u00e2tisseurs des \u00e9toiles ne marchaient pas toujours jusqu'\u00e0 leurs portes : ils se faisaient prendre par la lumi\u00e8re. Un faisceau descendu de nulle part, un froid bref, et l'on se retrouve ailleurs, recompos\u00e9 grain par grain. Certains soirs, un rayon p\u00e2le traverse encore les nuages au-dessus des ruines, comme si quelqu'un, l\u00e0-haut, appelait toujours."},"particules":{"eclat":{"quand":"toujours","nombre":10,"duree":1,"mouvement":"monte","au_sol":"disparait","rendu":"lumineux","sens":"camera","fin_de_vie":"retrecit","depart":"moyen","dispersion":45,"elan":0,"variation":"forte","rafale":"aucune","limite":256},"mc_dust_b4c8ff_10":{"quand":"toujours","nombre":4,"depart":"lent","dispersion":180,"rafale":"aucune","limite":128},"mc_electric_spark":{"quand":"toujours","nombre":4,"depart":"rapide","dispersion":180,"rafale":"aucune","limite":128},"mc_firework":{"quand":"toujours","nombre":10,"depart":"rapide","dispersion":45,"rafale":"aucune","limite":128},"strie":{"quand":"toujours","nombre":6,"duree":1,"mouvement":"monte","au_sol":"disparait","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"rapide","dispersion":0,"elan":0,"variation":"legere","rafale":"aucune","limite":128}}}}}