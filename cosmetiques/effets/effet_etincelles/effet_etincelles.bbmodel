ire","description":"Des sceaux de lumi\u00e8re se tracent autour de vos mains ; au d\u00e9part, une \u00e9tincelle file en spirale et dessine une grande porte cr\u00e9pitante qui crache des gerbes, et vous la franchissez dans un \u00e9clair. \u00c0 l'arriv\u00e9e, vous en sortez sous une pluie de braises.","lore":"Les passeurs de la Forge Errante n'ont jamais construit de portes : ils les dessinent. Un geste de la main, un anneau de m\u00e9tal en fusion trac\u00e9 dans l'air, et le monde s'y plie le temps d'un pas. On reconna\u00eet leur passage aux petites br\u00fblures qu'ils laissent sur le sol, en cercle."},"particules":{"braise":{"quand":"toujours","nombre":6,"duree":3,"mouvement":"lourde","au_sol":"pose","rendu":"lumineux","sens":"camera","fin_de_vie":"retrecit","depart":"moyen","dispersion":45,"elan":0,"variation":"forte","rafale":"aucune","limite":256},"etincelle":{"quand":"toujours","nombre":10,"duree":1,"mouvement":"normale","au_sol":"disparait","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"rapide","dispersion":15,"elan":0,"variation":"forte","rafale":"aucune","limite":256},"glyphe":{"quand":"toujours","nombre":2,"duree":3,"mouvement":"monte","au_sol":"pose","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"lent","dispersion":45,"elan":0,"variation":"legere","rafale":"aucune","limite":128},"mc_electric_spark":{"quand":"toujours","nombre":4,"depart":"rapide","dispersion":180,"rafale":"aucune","limite":128},"mc_small_flame":{"quand":"toujours","nombre":2,"depart":"lent","dispersion":15,"rafale":"aucune","limite":128},"mc_wax_on":{"quand":"toujours","nombre":6,"depart":"moyen","dispersion":45,"rafale":"aucune","limite":256}}}}}