lore":"Certains voyageurs ne marchent pas : ils plient le monde. D'un regard, l'espace se tord autour d'eux comme un tissu qu'on essore, et ils glissent dans le pli jusqu'\u00e0 n'\u00eatre plus qu'un point. Ailleurs, le pli se d\u00e9fait et les rend au monde. Personne ne sait ce qu'on voit entre les deux."},"particules":{"eclat":{"quand":"toujours","nombre":10,"duree":1,"mouvement":"flotte","au_sol":"pose","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"rapide","dispersion":180,"elan":0,"variation":"forte","rafale":"aucune","limite":64},"fragment":{"quand":"toujours","nombre":6,"duree":1,"mouvement":"legere","au_sol":"disparait","rendu":"opaque","sens":"libre","fin_de_vie":"retrecit","depart":"rapide","dispersion":15,"elan":0,"variation":"forte","rafale":"aucune","limite":64},"mc_portal":{"quand":"toujours","nombre":10,"depart":"moyen","dispersion":180,"rafale":"aucune","limite":128},"mc_reverse_portal":{"quand":"toujours","nombre":6,"depart":"lent","dispersion":45,"rafale":"aucune","limite":128},"mc_smoke":{"quand":"toujours","nombre":6,"depart":"lent","dispersion":180,"rafale":"aucune","limite":64},"mc_squid_ink":{"quand":"toujours","nombre":4,"depart":"moyen","dispersion":15,"rafale":"aucune","limite":64},"poussiere":{"quand":"toujours","nombre":10,"duree":1,"mouvement":"legere","au_sol":"disparait","rendu":"translucide","sens":"camera","fin_de_vie":"fondu","depart":"rapide","dispersion":15,"elan":0,"variation":"forte","rafale":"aucune","limite":128}}}}}