"loop","override":false,"length":2.0,"snapping":24,"selected":false,"animators":{"e9d847b0-166f-462d-bb38-95c7f9d08a93":{"name":"particle_cendre","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"0.0"}],"time":0.0},{"channel":"rotation","data_points":[{"x":"360.0","y":"0.0","z":"360.0"}],"time":2.0}]}}}],"phynaria_sounds":{"neant_os":"data:audio/ogg;base64,","neant_dechire":"data:audio/ogg;base64,","neant_presence":"data:audio/ogg;base64,","neant_impact":"data:audio/ogg;base64,"},"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"D\u00e9chirure du N\u00e9ant","ensemble":"Admin","rarete":"mythique","description":"Une couture lumineuse s'allume dans le ciel. Des mains d'os noires la percent, l'agrippent et l'\u00e9cartent : derri\u00e8re, le vide, et un masque blanc g\u00e9ant qui vous regarde. \u00c0 l'arriv\u00e9e, il vous laisse tomber ; au d\u00e9part, une main descend vous saisir.","lore":"Sous le ciel de Phynaria, il y a autre chose que le ciel. Les Gardiens n'en parlent jamais, mais certains d'entre eux ne voyagent pas seuls : quelque chose, de l'autre c\u00f4t\u00e9, leur ouvre le passage de ses propres mains. Ceux qui ont crois\u00e9 son regard blanc disent qu'il ne cligne pas, et qu'il se souvient de chaque visage."},"particules":{"braise":{"quand":"toujours","nombre":6,"duree":3,"mouvement":"monte","au_sol":"pose","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"moyen","dispersion":45,"elan":100,"variation":"forte","rafale":"aucune","limite":128},"cendre":{"quand":"toujours","nombre":4,"duree":3,"mouvement":"legere","au_sol":"disparait","rendu":"opaque","sens":"libre","fin_de_vie":"retrecit","depart":"lent","dispersion":45,"elan":100,"variation":"forte","rafale":"aucune","limite":128},"mc_ash":{"quand":"toujours","nombre":6,"depart":"lent","dispersion":180,"rafale":"aucune","limite":128},"mc_reverse_portal":{"quand":"toujours","nombre":10,"depart":"moyen","dispersion":180,"rafale":"aucune","limite":128},"mc_smoke":{"quand":"toujours","nombre":10,"depart":"rapide","dispersion":45,"rafale":"aucune","limite":128},"mc_squid_ink":{"quand":"toujours","nombre":4,"depart":"lent","dispersion":45,"rafale":"aucune","limite":64}}}}}