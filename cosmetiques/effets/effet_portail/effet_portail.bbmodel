b0dbef56-8db0-4499-9815-e1125e2f3a48","name":"particle_poussiere_fall","loop":"loop","override":false,"length":0.5,"snapping":24,"selected":false,"animators":{"af4c5f23-77f2-4ae7-8fa8-726b5064a019":{"name":"particle_poussiere","type":"bone","keyframes":[{"channel":"scale","data_points":[{"x":"1.0","y":"1.0","z":"1.0"}],"time":0.0},{"channel":"scale","data_points":[{"x":"1.2121","y":"1.2121","z":"1.2121"}],"time":0.062},{"channel":"scale","data_points":[{"x":"1.6","y":"1.6","z":"1.6"}],"time":0.125},{"channel":"scale","data_points":[{"x":"1.2121","y":"1.2121","z":"1.2121"}],"time":0.188},{"channel":"scale","data_points":[{"x":"1.0","y":"1.0","z":"1.0"}],"time":0.25},{"channel":"scale","data_points":[{"x":"1.0","y":"1.0","z":"1.0"}],"time":0.5}]}}}],"phynaria_sounds":{"portail_ouvre":"data:audio/ogg;base64,","portail_passe":"data:audio/ogg;base64,","portail_ferme":"data:audio/ogg;base64,"},"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"Portail de passage","ensemble":"Runes","rarete":"legendaire","description":"Des runes s'allument en cercle devant vous. Au d\u00e9part, l'air se d\u00e9chire en un portail ovale de lumi\u00e8re bleue, entour\u00e9 de runes et d'\u00e9clats de pierre en orbite : vous le traversez et il implose. \u00c0 l'arriv\u00e9e, un portail s'ouvre dans votre dos et vous en sortez.","lore":"Bien avant les routes, les graveurs de runes tra\u00e7aient douze signes dans le vide pour plier la distance. Le cercle tend l'air comme une toile ; un pas de plus et elle se d\u00e9chire sur un couloir de lumi\u00e8re. On dit que chaque portail arrache un peu de la pierre du lieu qu'on quitte, et qu'elle tourne autour de vous jusqu'\u00e0 ce que la porte se referme."},"particules":{"etincelle":{"quand":"toujours","nombre":10,"duree":1,"mouvement":"flotte","au_sol":"pose","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"poussee","dispersion":180,"elan":0,"variation":"forte","rafale":"aucune","limite":128},"mc_dust_7fc8ff_12":{"quand":"toujours","nombre":6,"depart":"lent","dispersion":45,"rafale":"aucune","limite":64},"mc_electric_spark":{"quand":"toujours","nombre":4,"depart":"poussee","dispersion":180,"rafale":"aucune","limite":64},"mc_portal":{"quand":"toujours","nombre":6,"depart":"poussee","dispersion":180,"rafale":"aucune","limite":128},"mc_reverse_portal":{"quand":"toujours","nombre":10,"depart":"moyen","dispersion":180,"rafale":"aucune","limite":128},"poussiere":{"quand":"toujours","nombre":10,"duree":1,"mouvement":"flotte","au_sol":"pose","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"rapide","dispersion":180,"elan":0,"variation":"forte","rafale":"aucune","limite":128},"rune":{"quand":"toujours","nombre":2,"duree":3,"mouvement":"monte","au_sol":"pose","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"lent","dispersion":45,"elan":0,"variation":"legere","rafale":"aucune","limite":64}}}}}