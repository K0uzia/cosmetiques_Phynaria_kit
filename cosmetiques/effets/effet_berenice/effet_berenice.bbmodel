7889ae4a0","name":"particle_lueur_fall","loop":"loop","override":false,"length":1.6,"snapping":24,"selected":false,"animators":{"b560cd8a-04d2-4454-9b55-e3b5ff40187d":{"name":"particle_lueur","type":"bone","keyframes":[{"channel":"scale","data_points":[{"x":"1.0","y":"1.0","z":"1.0"}],"time":0.0},{"channel":"scale","data_points":[{"x":"1.125","y":"1.125","z":"1.125"}],"time":0.133},{"channel":"scale","data_points":[{"x":"1.2165","y":"1.2165","z":"1.2165"}],"time":0.267},{"channel":"scale","data_points":[{"x":"1.25","y":"1.25","z":"1.25"}],"time":0.4},{"channel":"scale","data_points":[{"x":"1.2165","y":"1.2165","z":"1.2165"}],"time":0.533},{"channel":"scale","data_points":[{"x":"1.125","y":"1.125","z":"1.125"}],"time":0.667},{"channel":"scale","data_points":[{"x":"0.875","y":"0.875","z":"0.875"}],"time":0.933},{"channel":"scale","data_points":[{"x":"0.7835","y":"0.7835","z":"0.7835"}],"time":1.067},{"channel":"scale","data_points":[{"x":"0.75","y":"0.75","z":"0.75"}],"time":1.2},{"channel":"scale","data_points":[{"x":"0.7835","y":"0.7835","z":"0.7835"}],"time":1.333},{"channel":"scale","data_points":[{"x":"0.875","y":"0.875","z":"0.875"}],"time":1.467},{"channel":"scale","data_points":[{"x":"1.0","y":"1.0","z":"1.0"}],"time":1.6}]}}}],"phynaria_sounds":{"envol_celeste":"data:audio/ogg;base64,","descente_celeste":"data:audio/ogg;base64,"},"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"Ascension de B\u00e9r\u00e9nice","ensemble":"B\u00e9r\u00e9nice","rarete":"epique","description":"Un cercle d'\u00e9toiles s'allume sous vos pieds ; au d\u00e9part, des ailes de lumi\u00e8re se referment sur vous en cocon, qui s'\u00e9l\u00e8ve et \u00e9clate en gerbe de plumes. \u00c0 l'arriv\u00e9e, le ciel s'ouvre et vous descendez ailes d\u00e9ploy\u00e9es, qui se dissipent en plumes quand vous vous posez.","lore":"On dit que la reine, chaque soir, montait regarder sa chevelure devenue constellation. Ceux que B\u00e9r\u00e9nice prot\u00e8ge ne voyagent pas : ils sont rappel\u00e9s au ciel un instant, puis rendus \u00e0 la terre un peu plus loin. Les plumes qui restent derri\u00e8re eux sont le seul signe qu'ils sont pass\u00e9s."},"particules":{"etincelle":{"quand":"toujours","nombre":6,"duree":1,"mouvement":"legere","au_sol":"disparait","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"rapide","dispersion":180,"elan":0,"variation":"forte","rafale":"aucune","limite":128},"etoile":{"quand":"toujours","nombre":4,"duree":3,"mouvement":"monte","au_sol":"pose","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"lent","dispersion":15,"elan":0,"variation":"legere","rafale":"aucune","limite":128},"lueur":{"quand":"toujours","nombre":4,"duree":3,"mouvement":"monte","au_sol":"pose","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"lent","dispersion":45,"elan":0,"variation":"legere","rafale":"aucune","limite":128},"mc_dust_ffd27a_10":{"quand":"toujours","nombre":4,"depart":"lent","dispersion":45,"rafale":"aucune","limite":128},"plume":{"quand":"toujours","nombre":4,"duree":6,"mouvement":"legere","au_sol":"pose","rendu":"opaque","sens":"libre","fin_de_vie":"retrecit","depart":"moyen","dispersion":180,"elan":0,"variation":"forte","rafale":"aucune","limite":128}}}}}