l":"scale","data_points":[{"x":"0.7","y":"0.7","z":"0.7"}],"time":0.225},{"channel":"scale","data_points":[{"x":"0.7879","y":"0.7879","z":"0.7879"}],"time":0.263},{"channel":"scale","data_points":[{"x":"1.0","y":"1.0","z":"1.0"}],"time":0.3}]}}},{"uuid":"56ca43dc-ab3d-4ec0-a11a-a7ffe60f2ccd","name":"particle_eclat_fall","loop":"loop","override":false,"length":1.0,"snapping":30,"selected":false,"animators":{"eb5fa5a8-646d-4e94-98cd-3f9c61d69933":{"name":"particle_eclat","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"0.0"}],"time":0.0},{"channel":"rotation","data_points":[{"x":"0.0","y":"360.0","z":"0.0"}],"time":1.0}]}}}],"phynaria_sounds":{"anneaux_descente":"data:audio/ogg;base64,","anneaux_eclair":"data:audio/ogg;base64,","anneaux_retour":"data:audio/ogg;base64,"},"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"Anneaux de transport","ensemble":"Stellaire","rarete":"legendaire","description":"Une plaque grav\u00e9e s'\u00e9claire sous vos pieds, puis cinq anneaux d\u2019acier sombre descendent du ciel et s'empilent autour de vous ; une onde de lumi\u00e8re remonte la colonne et vous emporte, avant que les anneaux ne repartent vers les \u00e9toiles.","lore":"Les b\u00e2tisseurs disparus ne voyageaient pas seulement par leurs grandes portes : pour les courtes distances, ils appelaient des anneaux. Il suffit de se tenir sur l'une de leurs plaques grav\u00e9es pour qu'ils tombent du ciel, se referment en colonne autour du voyageur et l'\u00e9changent contre la lumi\u00e8re. On raconte qu'au sommet de la colonne, l'espace d'un battement, on aper\u00e7oit le noir glac\u00e9 entre les \u00e9toiles."},"particules":{"eclat":{"quand":"toujours","nombre":10,"duree":1,"mouvement":"monte","au_sol":"pose","rendu":"lumineux","sens":"camera","fin_de_vie":"retrecit","depart":"rapide","dispersion":45,"elan":0,"variation":"forte","rafale":"aucune","limite":128},"etincelle":{"quand":"toujours","nombre":10,"duree":1,"mouvement":"lourde","au_sol":"disparait","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"rapide","dispersion":45,"elan":0,"variation":"forte","rafale":"aucune","limite":256},"mc_electric_spark":{"quand":"toujours","nombre":6,"depart":"rapide","dispersion":180,"rafale":"aucune","limite":128},"mc_wax_on":{"quand":"toujours","nombre":6,"depart":"moyen","dispersion":45,"rafale":"aucune","limite":256},"poussiere":{"quand":"toujours","nombre":4,"duree":3,"mouvement":"monte","au_sol":"pose","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"lent","dispersion":15,"elan":0,"variation":"legere","rafale":"aucune","limite":128}}}}}