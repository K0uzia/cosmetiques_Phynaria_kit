dled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"Ciel d'alv\u00e9oles","ensemble":"Admin","rarete":"mythique","description":"Des panneaux \u00ab ALERTE SYST\u00c8ME \u00bb s'allument un \u00e0 un et pavent le ciel ; du sang suinte des jointures, coule en filets et se rassemble en une poche lisse et luisante qui se vide en pluie de filets : le joueur en sort g\u00e9ant, puis redescend.","lore":"Quand le monde doit \u00e9couter, le ciel se couvre d'alv\u00e9oles \u00e9carlates, chacune marqu\u00e9e du sceau de ceux qui l'ont b\u00e2ti. Ce qui coule alors des jointures n'est pas de la pluie : c'est la volont\u00e9 du monde qui se condense. On raconte que celui qui en sort a \u00e9t\u00e9 un instant aussi grand que le ciel."},"particules":{"etincelle":{"quand":"toujours","nombre":10,"duree":3,"mouvement":"monte","au_sol":"pose","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"lent","dispersion":15,"elan":100,"variation":"forte","rafale":"aucune","limite":256},"goutte":{"quand":"toujours","nombre":6,"duree":6,"mouvement":"lourde","au_sol":"disparait","rendu":"opaque","sens":"camera","fin_de_vie":"retrecit","depart":"lent","dispersion":15,"elan":100,"variation":"forte","rafale":"aucune","limite":256},"mc_dust_8c0c1c_15":{"quand":"toujours","nombre":6,"depart":"lent","dispersion":45,"rafale":"aucune","limite":128},"mc_dust_ff8c8c_10":{"quand":"toujours","nombre":6,"depart":"lent","dispersion":180,"rafale":"aucune","limite":128}}}}}