e":1.12}]}}},{"uuid":"b2e486e6-9fbe-4188-91d1-d7d7456e7761","name":"overlay_ambiance","loop":"loop","override":false,"length":1.0,"snapping":24,"selected":false,"animators":{"63b0cf0f-d46b-4d42-8e0a-bc53808b1e2c":{"name":"ctrl_teinte","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.22 * v.pluie","y":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.17 * v.pluie","z":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.06 * v.pluie"}],"time":0}]},"9b306dc6-c7f4-464a-ba01-e2fa0835a48c":{"name":"ctrl_lumiere","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); 0.3 + 0.5 * math.clamp((0.27 - math.abs(q.time_of_day - 0.5)) * 6, 0, 1) + 0.3 * v.pluie","y":"0","z":"0"}],"time":0}]},"c3471352-de6f-49f8-abe6-5837464d87f0":{"name":"ctrl_teinte","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.22 * v.pluie","y":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.17 * v.pluie","z":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.06 * v.pluie"}],"time":0}]},"14f0bff1-5411-451e-b29f-003721175c18":{"name":"ctrl_lumiere","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); 0.3 + 0.5 * math.clamp((0.27 - math.abs(q.time_of_day - 0.5)) * 6, 0, 1) + 0.3 * v.pluie","y":"0","z":"0"}],"time":0}]}}}],"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"\u00c9pauli\u00e8res Steampunk","ensemble":"Steampunk","rarete":"epique","description":"\u00c9pauli\u00e8res en \u00e9ventail de lames rivet\u00e9es (laiton, acier, cuivre) autour d'un moyeu \u00e0 engrenage : la roue arme la pompe cran par cran, l'aiguille du manom\u00e8tre grimpe \u00e0 gauche, les chemin\u00e9es de droite d\u00e9chargent la vapeur et les lames claquent d'un cran.","lore":"Les chaudronniers de l'Atelier de laiton les assemblent sur le mod\u00e8le des vieilles \u00e9pauli\u00e8res d'armure, lame apr\u00e8s lame, mais chaque rivet tient un ressort et chaque moyeu une roue d'horloge. Elles respirent au rythme de leur porteur : on dit qu'un apprenti sait qu'il est devenu compagnon le jour o\u00f9 ses \u00e9pauli\u00e8res sifflent avant lui."},"particules":{"mc_white_smoke":{"quand":"toujours","nombre":2,"depart":"lent","dispersion":15,"rafale":"aucune","limite":64}}}}}