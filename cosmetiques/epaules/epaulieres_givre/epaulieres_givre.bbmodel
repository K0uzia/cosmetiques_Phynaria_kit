"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); 0.3 + 0.5 * math.clamp((0.27 - math.abs(q.time_of_day - 0.5)) * 6, 0, 1) + 0.3 * v.pluie","y":"0","z":"0"}],"time":0}]},"2ac50371-54c4-48d0-95f0-22c2401c24ce":{"name":"ctrl_teinte","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.22 * v.pluie","y":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.17 * v.pluie","z":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.06 * v.pluie"}],"time":0}]},"f46bdfc1-4960-4e69-81c9-e54dd53dca18":{"name":"ctrl_lumiere","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); 0.3 + 0.5 * math.clamp((0.27 - math.abs(q.time_of_day - 0.5)) * 6, 0, 1) + 0.3 * v.pluie","y":"0","z":"0"}],"time":0}]}}}],"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"\u00c9pauli\u00e8res de givre","ensemble":"Givre","rarete":"epique","description":"Paire asym\u00e9trique d'\u00e9cailles de glace translucide qui couvrent l'\u00e9paule et le haut du bras, d'o\u00f9 jaillit une grappe de cristaux hexagonaux \u00e0 c\u0153ur cyan lumineux ; une rosace de givre scelle chaque coque. La glace pousse quand on les \u00e9quipe.","lore":"Les gardiens du C\u0153ur d'Hiver ne portent pas d'armure : ils laissent la glace pousser l\u00e0 o\u00f9 les coups tombent. L'\u00e9paule gauche, celle qui pare, se couvre d'une grappe plus haute ; les cristaux bris\u00e9s se reforment en une nuit, autour de la m\u00eame rosace."},"particules":{"scintille":{"quand":"toujours","nombre":0.5,"duree":1,"mouvement":"flotte","au_sol":"pose","rendu":"translucide","sens":"camera","fin_de_vie":"fondu","depart":"poussee","dispersion":45,"elan":100,"variation":"legere","rafale":"aucune","limite":64}}}}}