points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); 0.3 + 0.5 * math.clamp((0.27 - math.abs(q.time_of_day - 0.5)) * 6, 0, 1) + 0.3 * v.pluie","y":"0","z":"0"}],"time":0}]}}}],"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"\u00c9paulettes fraise chantilly","ensemble":"P\u00e2tisserie","rarete":"rare","description":"Paire d'\u00e9paulettes p\u00e2tissi\u00e8res : nappage fraise brillant qui coule en gouttes sur des tuiles de p\u00e2te sabl\u00e9e, chantilly poch\u00e9e, fraise et cerise, tenues par des rubans de chocolat nou\u00e9s. La chantilly s'\u00e9crase et rebondit \u00e0 chaque pas et \u00e0 l'atterrissage.","lore":"Au fond de la Vitrine enchant\u00e9e, le p\u00e2tissier garde les g\u00e2teaux qui ont trop bien lev\u00e9. Ceux-l\u00e0 ne tiennent plus sur une assiette : il les noue d'un ruban de chocolat et les pose sur les \u00e9paules de ceux qui reviennent le plus souvent. La chantilly reste ferme tant qu'on a le sourire."}}}}