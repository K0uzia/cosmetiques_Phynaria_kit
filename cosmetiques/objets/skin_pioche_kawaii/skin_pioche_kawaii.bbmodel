envolent."},"particules":{"mc_heart":{"quand":"toujours","nombre":2,"depart":"lent","dispersion":45,"rafale":"aucune","limite":64}}}},"phynaria_sounds":{"pof_sucre":"data:audio/ogg;base64,"}}