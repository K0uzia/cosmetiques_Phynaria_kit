0.849,0.849]},"gui":{"rotation":[0,0,-45],"translation":[0,0,0],"scale":[0.6,0.6,0.6]},"head":{"rotation":[0,180,0],"translation":[0,13,7],"scale":[1,1,1]},"ground":{"rotation":[0,0,0],"translation":[0,2,0],"scale":[0.4,0.4,0.4]},"fixed":{"rotation":[0,180,-45],"translation":[0,0,0],"scale":[0.5,0.5,0.5]}}},"fiche":{"nom":"Pique-C\u0153ur","ensemble":"Kawaii","rarete":"epique","description":"Skin de lance : une feuille de sucre lilas \u00e0 bout rond, sertie de drag\u00e9es-c\u0153urs lumineuses, sur un c\u0153ur framboise \u00e0 deux petites ailes, au bout d'une hampe de guimauve torsad\u00e9e. Les ailes battent pendant la charge ; au coup qui touche, une bouff\u00e9e de petits c\u0153urs s'envole.","lore":"\u00c0 Nuage Guimauve, les lances ne chassent rien : elles vont chercher les gens tristes, si loin soient-ils. Celle-ci a pouss\u00e9 deux ailes de sucre le jour o\u00f9 son c\u0153ur de framboise a voulu voler plus vite que son porteur. Quand on charge avec elle, on l'entend battre ; ceux qu'elle touche repartent avec un c\u0153ur de plus."},"particules":{"mc_heart":{"quand":"toujours","nombre":2,"depart":"lent","dispersion":45,"rafale":"aucune","limite":64}}}},"phynaria_sounds":{"pof_sucre":"data:audio/ogg;base64,"}}