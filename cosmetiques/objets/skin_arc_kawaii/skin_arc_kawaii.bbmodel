.4},{"channel":"scale","data_points":[{"x":"0.946","y":"0.946","z":"0.946"}],"time":0.425},{"channel":"scale","data_points":[{"x":"1.0198","y":"1.0198","z":"1.0198"}],"time":0.5},{"channel":"scale","data_points":[{"x":"1.0012","y":"1.0012","z":"1.0012"}],"time":0.575},{"channel":"scale","data_points":[{"x":"1.0","y":"1.0","z":"1.0"}],"time":0.6}]}}}],"unhandled_root_fields":{"phynaria":{"version":1,"objet":{"type":"arc","affichage":{"thirdperson_righthand":{"rotation":[-80,260,-40],"translation":[-1,-2,2.5],"scale":[0.9,0.9,0.9]},"thirdperson_lefthand":{"rotation":[-80,-280,40],"translation":[-1,-2,2.5],"scale":[0.9,0.9,0.9]},"firstperson_righthand":{"rotation":[0,-90,25],"translation":[1.13,3.2,1.13],"scale":[0.68,0.68,0.68]},"firstperson_lefthand":{"rotation":[0,90,-25],"translation":[1.13,3.2,1.13],"scale":[0.68,0.68,0.68]},"gui":{"rotation":[0,0,0],"translation":[-0.41,0.92,0],"scale":[0.848,0.848,0.848]},"head":{"rotation":[0,180,0],"translation":[0,13,7],"scale":[1,1,1]},"ground":{"rotation":[0,0,0],"translation":[0,2,0],"scale":[0.5,0.5,0.5]},"fixed":{"rotation":[0,180,0],"translation":[0,0,0],"scale":[1,1,1]}}},"fiche":{"nom":"Arc de guimauve","ensemble":"Kawaii","rarete":"epique","description":"Skin d'arc : tous tes arcs deviennent un arc de confiserie, branches de guimauve torsad\u00e9e rose et cr\u00e8me, petits nuages aux bouts, gros c\u0153ur de sucre en poign\u00e9e et corde lumineuse. Le c\u0153ur bat plus fort quand tu bandes, la fl\u00e8che se charge d'une pointe en c\u0153ur, et au tir un nuage de sucre paillet\u00e9\u2026","lore":"\u00c0 Nuage Guimauve, on ne chasse rien : on vise les gens qu'on aime. Cet arc a \u00e9t\u00e9 tress\u00e9 dans deux brins de guimauve encore ti\u00e8des, nou\u00e9s \u00e0 deux nuages du matin, et son c\u0153ur de sucre bat chaque fois qu'on le tend. Ses fl\u00e8ches ne blessent personne ; elles laissent seulement, l\u00e0 o\u00f9 elles passent, une petite pluie de paillettes."},"particules":{"mc_heart":{"quand":"utilisation","nombre":1,"depart":"lent","dispersion":45,"rafale":"tir","limite":64}}}},"phynaria_sounds":{"paillettes":"data:audio/ogg;base64,"}}