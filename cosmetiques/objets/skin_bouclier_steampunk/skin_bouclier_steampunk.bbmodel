],"scale":[1,1,1]},"ground":{"rotation":[0,0,0],"translation":[2,4,2],"scale":[0.25,0.25,0.25]},"fixed":{"rotation":[0,180,0],"translation":[-4.5,4.5,-5],"scale":[0.55,0.55,0.55]},"on_shelf":{"rotation":[0,0,0],"translation":[11,18.5,8.7],"scale":[1.4,1.4,1.4]}}},"fiche":{"nom":"Rondache de chaudi\u00e8re","ensemble":"Steampunk","rarete":"epique","description":"Skin de bouclier : une porte de chaudi\u00e8re en acier rivet\u00e9 mont\u00e9e sur une roue dent\u00e9e de laiton, manom\u00e8tre ambre au centre. Au dos, une petite chaudi\u00e8re \u00e0 foyer rougeoyant fait monter la pression cran par cran ; un coup par\u00e9 l\u00e2che de la vapeur, et au coup qui touche la soupape crache un jet.","lore":"Les chaudronniers de l'Atelier de laiton gardent toujours une porte de chaudi\u00e8re de rebut : l'acier qui a tenu la pression tient aussi les coups. Ils l'ont sertie dans une roue dent\u00e9e et lui ont laiss\u00e9 un petit foyer au dos, pour qu'elle reste chaude. Quand l'aiguille touche le rouge, la soupape siffle, et l'adversaire comprend qu'il frappe une machine qui travaille."},"particules":{"mc_white_smoke":{"quand":"toujours","nombre":2,"depart":"lent","dispersion":15,"rafale":"aucune","limite":64}}}}}