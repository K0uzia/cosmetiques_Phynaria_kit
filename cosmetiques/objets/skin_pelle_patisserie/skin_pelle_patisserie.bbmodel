-ab81-1645e04837e4","name":"particle_vermicelle_ciel_fall","loop":"loop","override":false,"length":1.0,"snapping":24,"selected":false,"animators":{"6fc1553e-fdf2-4f62-b0a4-a2a783e6d202":{"name":"particle_vermicelle_ciel","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"0.0"}],"time":0.0},{"channel":"rotation","data_points":[{"x":"360.0","y":"0.0","z":"720.0"}],"time":1.0}]}}}],"unhandled_root_fields":{"phynaria":{"version":1,"objet":{"type":"pelle","affichage":{"thirdperson_righthand":{"rotation":[0,-90,55],"translation":[0,4,0.5],"scale":[0.85,0.85,0.85]},"thirdperson_lefthand":{"rotation":[0,90,-55],"translation":[0,4,0.5],"scale":[0.85,0.85,0.85]},"firstperson_righthand":{"rotation":[0,-90,25],"translation":[1.13,3.2,1.13],"scale":[0.68,0.68,0.68]},"firstperson_lefthand":{"rotation":[0,90,-25],"translation":[1.13,3.2,1.13],"scale":[0.68,0.68,0.68]},"gui":{"rotation":[0,0,0],"translation":[0,0,0],"scale":[0.86,0.86,0.86]},"head":{"rotation":[0,180,0],"translation":[0,13,7],"scale":[1,1,1]},"ground":{"rotation":[0,0,0],"translation":[0,2,0],"scale":[0.5,0.5,0.5]},"fixed":{"rotation":[0,180,0],"translation":[0,0,0],"scale":[1,1,1]}}},"fiche":{"nom":"Pelle \u00e0 tarte napp\u00e9e","ensemble":"P\u00e2tisserie","rarete":"rare","description":"Skin de pelle : remplace toutes tes pelles par une pelle \u00e0 tarte d'acier au bord dentel\u00e9, manche de h\u00eatre tremp\u00e9 dans le chocolat, la lame encore napp\u00e9e de gla\u00e7age fraise qui coule. Le nappage tremble \u00e0 chaque coup, et chaque bloc cass\u00e9 l\u00e2che une pinc\u00e9e de vermicelles qui s'envolent.","lore":"\u00c0 la Vitrine enchant\u00e9e, la pelle \u00e0 tarte ne quitte jamais le bol de nappage : le p\u00e2tissier dit qu'une part se sert mieux quand la lame est d\u00e9j\u00e0 sucr\u00e9e. Un apprenti l'a emport\u00e9e un jour pour creuser son jardin. La terre s'est mise \u00e0 sentir la fraise, et les vermicelles n'ont jamais cess\u00e9 de sortir des mottes."},"particules":{"vermicelle_ciel":{"quand":"toujours","nombre":1,"duree":1,"mouvement":"monte","au_sol":"disparait","rendu":"opaque","sens":"libre","fin_de_vie":"retrecit","depart":"lent","dispersion":45,"elan":40,"variation":"forte","rafale":"aucune","limite":64},"vermicelle_citron":{"quand":"toujours","nombre":1,"duree":1,"mouvement":"monte","au_sol":"disparait","rendu":"opaque","sens":"libre","fin_de_vie":"retrecit","depart":"lent","dispersion":45,"elan":40,"variation":"forte","rafale":"aucune","limite":64},"vermicelle_menthe":{"quand":"toujours","nombre":1,"duree":1,"mouvement":"monte","au_sol":"disparait","rendu":"opaque","sens":"libre","fin_de_vie":"retrecit","depart":"lent","dispersion":45,"elan":40,"variation":"forte","rafale":"aucune","limite":64}}}}}