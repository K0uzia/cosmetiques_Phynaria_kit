lation":[2,0.1,-3],"scale":[0.9,0.9,0.9]},"firstperson_righthand":{"rotation":[-90,0,-55],"translation":[1.13,3.2,1.13],"scale":[0.68,0.68,0.68]},"firstperson_lefthand":{"rotation":[-90,0,35],"translation":[1.13,3.2,1.13],"scale":[0.68,0.68,0.68]},"gui":{"rotation":[0,0,0],"translation":[0.78,-0.78,0],"scale":[1.0,1.0,1.0]},"head":{"rotation":[0,180,0],"translation":[0,13,7],"scale":[1,1,1]},"ground":{"rotation":[0,0,0],"translation":[0,2,0],"scale":[0.5,0.5,0.5]},"fixed":{"rotation":[0,180,0],"translation":[0,0,0],"scale":[1,1,1]}}},"fiche":{"nom":"Arbal\u00e8te de givre","ensemble":"Givre","rarete":"epique","description":"Skin d'arbal\u00e8te : un arc court de glace taill\u00e9e sur un f\u00fbt d'argent froid, crosse au flocon lumineux. Quand elle est charg\u00e9e, le carreau de cristal se couvre de givre ; au tir, un nuage de flocons jaillit devant l'arc.","lore":"Les gardiens du C\u0153ur d'Hiver ont scell\u00e9 un f\u00fbt d'argent dans la glace d'un lac gel\u00e9, et l'arc y a pouss\u00e9 en une nuit, court et dur comme un \u00e9clat. La corde est un fil de givre ; le carreau, un cristal que le froid habille d\u00e8s qu'il est pos\u00e9. Quand il part, l'air qu'il traverse se change en neige."},"particules":{"mc_snowflake":{"quand":"toujours","nombre":2,"depart":"rapide","dispersion":45,"rafale":"tir","limite":64}}}}}