0,-4.144,2.033],"scale":[0.9936,0.9936,0.9936]},"firstperson_lefthand":{"rotation":[0.0,90.0,-25.0],"translation":[5.0,-4.144,2.033],"scale":[0.9936,0.9936,0.9936]},"gui":{"rotation":[0,0,-45],"translation":[0,0,0],"scale":[0.52,0.52,0.52]},"head":{"rotation":[0,180,0],"translation":[0,13,7],"scale":[1,1,1]},"ground":{"rotation":[0,0,0],"translation":[0,2,0],"scale":[0.4,0.4,0.4]},"fixed":{"rotation":[0,180,-45],"translation":[0,0,0],"scale":[0.5,0.5,0.5]}}},"fiche":{"nom":"Trident de givre","ensemble":"Givre","rarete":"epique","description":"Skin de trident : trois dents de glace taill\u00e9es en prismes, au c\u0153ur cyan lumineux, serties dans une fourche d'argent en croissant. Lev\u00e9 pour lancer, le givre gagne les dents ; il part dans un \u00e9clat de glace et file en semant des flocons.","lore":"Les p\u00eacheurs du C\u0153ur d'Hiver ne taillent pas leurs dents de trident : ils posent une fourche d'argent sur la glace d'un lac et attendent la nuit. Au matin, trois cristaux y ont pouss\u00e9, droits comme des stalactites. Lanc\u00e9, le trident laisse derri\u00e8re lui une neige fine qui ne fond pas avant qu'il revienne."},"particules":{"mc_snowflake":{"quand":"toujours","nombre":2,"depart":"rapide","dispersion":45,"rafale":"tir","limite":64}}}}}