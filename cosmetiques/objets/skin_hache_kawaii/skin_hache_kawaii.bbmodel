ctrl_lumiere","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"0.0","y":"0.0","z":"0.0"}],"time":0.0},{"channel":"position","data_points":[{"x":"0.41","y":"0.0","z":"0.0"}],"time":0.025},{"channel":"position","data_points":[{"x":"0.6","y":"0.0","z":"0.0"}],"time":0.05},{"channel":"position","data_points":[{"x":"0.54","y":"0.0","z":"0.0"}],"time":0.175},{"channel":"position","data_points":[{"x":"0.03","y":"0.0","z":"0.0"}],"time":0.45},{"channel":"position","data_points":[{"x":"0.0","y":"0.0","z":"0.0"}],"time":0.8}]}}}],"unhandled_root_fields":{"phynaria":{"version":1,"objet":{"type":"hache","affichage":{"thirdperson_righthand":{"rotation":[0,-90,55],"translation":[0,4,0.5],"scale":[0.85,0.85,0.85]},"thirdperson_lefthand":{"rotation":[0,90,-55],"translation":[0,4,0.5],"scale":[0.85,0.85,0.85]},"firstperson_righthand":{"rotation":[0,-90,25],"translation":[1.13,3.2,1.13],"scale":[0.68,0.68,0.68]},"firstperson_lefthand":{"rotation":[0,90,-25],"translation":[1.13,3.2,1.13],"scale":[0.68,0.68,0.68]},"gui":{"rotation":[0,0,0],"translation":[0,0,0],"scale":[0.781,0.781,0.781]},"head":{"rotation":[0,180,0],"translation":[0,13,7],"scale":[1,1,1]},"ground":{"rotation":[0,0,0],"translation":[0,2,0],"scale":[0.5,0.5,0.5]},"fixed":{"rotation":[0,180,0],"translation":[0,0,0],"scale":[1,1,1]}}},"fiche":{"nom":"Coupe-Nuage","ensemble":"Kawaii","rarete":"epique","description":"Skin de hache : un large fer de sucre lilas aux coins tout ronds, serti de drag\u00e9es-c\u0153urs lumineuses, qui sort d'un gros c\u0153ur framboise, avec un petit nuage au dos et un manche de guimauve torsad\u00e9e. Le c\u0153ur bat doucement ; au coup qui touche, une bouff\u00e9e de petits c\u0153urs s'envole.","lore":"\u00c0 Nuage Guimauve, les b\u00fbcherons ne coupent pas les arbres : ils taillent les nuages trop gonfl\u00e9s pour qu'il ne pleuve pas sur les f\u00eates. Ce fer a \u00e9t\u00e9 tir\u00e9 au sucre lilas autour du m\u00eame c\u0153ur de framboise que les lames du village, et un bout du dernier nuage taill\u00e9 s'est coll\u00e9 au dos pour ne plus le quitter. Chaque coup laisse \u00e9chapper quelques c\u0153urs, comme des miettes."},"particules":{"mc_heart":{"quand":"toujours","nombre":2,"depart":"lent","dispersion":45,"rafale":"aucune","limite":64}}}},"phynaria_sounds":{"pof_sucre":"data:audio/ogg;base64,"}}