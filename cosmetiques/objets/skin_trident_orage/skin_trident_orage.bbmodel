:[0,0,0],"scale":[0.52,0.52,0.52]},"head":{"rotation":[0,180,0],"translation":[0,13,7],"scale":[1,1,1]},"ground":{"rotation":[0,0,0],"translation":[0,2,0],"scale":[0.4,0.4,0.4]},"fixed":{"rotation":[0,180,-45],"translation":[0,0,0],"scale":[0.5,0.5,0.5]}}},"fiche":{"nom":"Trident de l'orage","ensemble":"Orage","rarete":"epique","description":"Skin de trident : une fourche d'acier d'orage forg\u00e9e d'une pi\u00e8ce, trois dents biseaut\u00e9es o\u00f9 la foudre est couch\u00e9e. Lev\u00e9 pour lancer, des arcs sautent d'une pointe \u00e0 l'autre ; il part dans une d\u00e9charge et file chauff\u00e9 \u00e0 blanc, la foudre en tra\u00eene.","lore":"Les Dompteurs d'orage disent qu'un trident n'est qu'un paratonnerre qu'on ose lancer. Leurs forgerons battent la fourche d'une seule pi\u00e8ce sous l'averse, puis couchent l'\u00e9clair dans ses goutti\u00e8res. Tant qu'on le tient, la foudre dort ; d\u00e8s qu'on le l\u00e8ve, elle s'\u00e9veille d'une dent \u00e0 l'autre et ne demande plus qu'\u00e0 partir."},"particules":{"mc_electric_spark":{"quand":"toujours","nombre":2,"depart":"rapide","dispersion":45,"rafale":"tir","limite":64}}}},"phynaria_sounds":{"decharge_trident":"data:audio/ogg;base64,"}}