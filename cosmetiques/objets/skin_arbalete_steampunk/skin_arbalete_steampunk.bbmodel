cale":[0.5,0.5,0.5]},"fixed":{"rotation":[0,180,0],"translation":[0,0,0],"scale":[1,1,1]}}},"fiche":{"nom":"Arbal\u00e8te \u00e0 vapeur","ensemble":"Steampunk","rarete":"epique","description":"Skin d'arbal\u00e8te : remplace l'apparence de toutes tes arbal\u00e8tes par une arbal\u00e8te d'horloger, arc en lames de ressort de laiton, c\u00e2ble d'acier, f\u00fbt de bois sombre, engrenage de remontage \u00e0 manivelle et petit r\u00e9servoir de vapeur \u00e0 manom\u00e8tre.","lore":"Les chaudronniers de l'Atelier de laiton trouvaient indigne de bander une arbal\u00e8te \u00e0 la force des bras. Ils lui ont donn\u00e9 un ressort de voiture, un tambour et un peu de pression : un tour de manivelle par cran, et le manom\u00e8tre dit quand il faut s'arr\u00eater. Quand la lentille s'allume, la noix tient la corde, et plus rien ne la fera l\u00e2cher avant la d\u00e9tente."},"particules":{"mc_white_smoke":{"quand":"toujours","nombre":2,"depart":"lent","dispersion":15,"rafale":"aucune","limite":64}}}},"phynaria_sounds":{"tir_vapeur":"data:audio/ogg;base64,"}}