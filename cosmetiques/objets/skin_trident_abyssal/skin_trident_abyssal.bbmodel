":{"thirdperson_righthand":{"rotation":[0.0,60.0,0.0],"translation":[0.072,-2.599,0.928],"scale":[0.9936,0.9936,0.9936]},"thirdperson_lefthand":{"rotation":[0.0,60.0,0.0],"translation":[0.072,-2.599,1.072],"scale":[0.9936,0.9936,0.9936]},"firstperson_righthand":{"rotation":[0.0,-90.0,25.0],"translation":[5.0,-4.144,2.033],"scale":[0.9936,0.9936,0.9936]},"firstperson_lefthand":{"rotation":[0.0,90.0,-25.0],"translation":[5.0,-4.144,2.033],"scale":[0.9936,0.9936,0.9936]},"gui":{"rotation":[0,0,-45],"translation":[0,0,0],"scale":[0.6,0.6,0.6]},"head":{"rotation":[0,180,0],"translation":[0,13,7],"scale":[1,1,1]},"ground":{"rotation":[0,0,0],"translation":[0,2,0],"scale":[0.4,0.4,0.4]},"fixed":{"rotation":[0,180,-45],"translation":[0,0,0],"scale":[0.5,0.5,0.5]}}},"fiche":{"nom":"Fou\u00ebne de l'Abysse","ensemble":"Abyssal","rarete":"epique","description":"Skin de trident : remplace tous tes tridents par une fourche d'os noir \u00e0 trois dents, ardillons tourn\u00e9s vers le bas et pointes vert acide. La fourche sort du collet quand tu la prends en main ; lev\u00e9e, ses pointes s'allument, et elle part dans un \u00e9clat vert.","lore":"Dans les eaux noires du fond de l'Abysse nagent des choses qu'aucune lame n'atteint. Les Chasseurs les p\u00eachent comme on p\u00eache le saumon, \u00e0 la fou\u00ebne : trois dents taill\u00e9es dans la m\u00e2choire d'une b\u00eate du gouffre, des ardillons pour que rien ne glisse. Quand elle part, la lueur verte la suit comme un sillage, et il est rare qu'elle revienne sans prise."},"particules":{"mc_dust_82d335_8":{"quand":"toujours","nombre":2,"depart":"rapide","dispersion":45,"rafale":"tir","limite":64}}}}}