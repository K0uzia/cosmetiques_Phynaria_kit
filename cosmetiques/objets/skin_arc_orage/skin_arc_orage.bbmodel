ation":[1.13,3.2,1.13],"scale":[0.68,0.68,0.68]},"gui":{"rotation":[0,0,0],"translation":[0.55,-0.89,0],"scale":[0.945,0.945,0.945]},"head":{"rotation":[0,180,0],"translation":[0,13,7],"scale":[1,1,1]},"ground":{"rotation":[0,0,0],"translation":[0,2,0],"scale":[0.5,0.5,0.5]},"fixed":{"rotation":[0,180,0],"translation":[0,0,0],"scale":[1,1,1]}}},"fiche":{"nom":"Arc de l'orage","ensemble":"Orage","rarete":"epique","description":"Skin d'arc : tous tes arcs deviennent un arc d'acier d'orage aux branches en ailes de faucon repli\u00e9es, articul\u00e9es au poignet par un tambour d'or. Quand tu bandes, l'aile se replie et la corde se charge de foudre ; au tir, la fl\u00e8che part dans une d\u00e9charge.","lore":"Les Dompteurs d'orage disent que l'oiseau du tonnerre replie ses ailes juste avant de frapper. Leurs archers forgent donc leurs arcs en ailes repli\u00e9es, r\u00e9mige par r\u00e9mige, et tendent entre les deux pointes un fil de foudre prisonni\u00e8re. Plus on tire, plus la corde gronde ; on ne l\u00e2che jamais une fl\u00e8che, on l\u00e2che l'\u00e9clair qui la porte."},"particules":{"mc_electric_spark":{"quand":"toujours","nombre":2,"depart":"rapide","dispersion":45,"rafale":"tir","limite":64}}}},"phynaria_sounds":{"decharge_arc":"data:audio/ogg;base64,"}}