efthand":{"rotation":[-90,0,35],"translation":[1.13,3.2,1.13],"scale":[0.68,0.68,0.68]},"gui":{"rotation":[0,0,0],"translation":[1.85,-1.85,0],"scale":[1.0,1.0,1.0]},"head":{"rotation":[0,180,0],"translation":[0,13,7],"scale":[1,1,1]},"ground":{"rotation":[0,0,0],"translation":[0,2,0],"scale":[0.5,0.5,0.5]},"fixed":{"rotation":[0,180,0],"translation":[0,0,0],"scale":[1,1,1]}}},"fiche":{"nom":"Tire-Bisou","ensemble":"Kawaii","rarete":"epique","description":"Skin d'arbal\u00e8te : un gros c\u0153ur de sucre framboise porte deux bras de sucre lilas sertis de drag\u00e9es lumineuses, sur un f\u00fbt de guimauve torsad\u00e9e termin\u00e9 par un petit nuage. Le c\u0153ur bat plus fort pendant qu'on tend la corde, le carreau se charge d'une pointe en c\u0153ur, et au tir un nuage de sucre\u2026","lore":"\u00c0 Nuage Guimauve, on ne tire pas pour toucher, on tire pour atteindre. Le Tire-Bisou a \u00e9t\u00e9 taill\u00e9 dans un c\u0153ur de framboise trop lourd pour voler, auquel on a pr\u00eat\u00e9 deux bras de sucre. Il garde la corde tendue aussi longtemps qu'il le faut, puis il laisse partir, d'un coup, tout ce qu'il retenait : un bisou, et un peu de paillettes."},"particules":{"mc_heart":{"quand":"utilisation","nombre":1,"depart":"lent","dispersion":45,"rafale":"tir","limite":64}}}},"phynaria_sounds":{"paillettes":"data:audio/ogg;base64,"}}