":[0,2,0],"scale":[0.5,0.5,0.5]},"fixed":{"rotation":[0,180,0],"translation":[0,0,0],"scale":[1,1,1]}}},"fiche":{"nom":"Pelle C\u00e2line","ensemble":"Kawaii","rarete":"epique","description":"Skin de pelle : un fer de sucre lilas aux \u00e9paules douces et au bout tout rond, serti de drag\u00e9es-c\u0153urs lumineuses, qui sort d'un c\u0153ur framboise, sur un manche de guimauve torsad\u00e9e \u00e0 poign\u00e9e en D fleurie de nuages. Le c\u0153ur bat doucement et soupire parfois une bouff\u00e9e de petits c\u0153urs.","lore":"\u00c0 Nuage Guimauve, on ne creuse pas la terre : on la borde. Cette pelle a \u00e9t\u00e9 tir\u00e9e au sucre lilas autour du m\u00eame c\u0153ur de framboise que les lames du village, et sa poign\u00e9e garde deux petits nuages pour que la main ne s'ennuie jamais. \u00c0 chaque pellet\u00e9e elle se rel\u00e8ve avec un rebond, et quand le travail dure, elle pousse un soupir sucr\u00e9."},"particules":{"mc_heart":{"quand":"toujours","nombre":2,"depart":"lent","dispersion":45,"rafale":"aucune","limite":64}}}},"phynaria_sounds":{"pof_sucre":"data:audio/ogg;base64,"}}