root_fields":{"phynaria":{"version":1,"objet":{"type":"bouclier","affichage":{"thirdperson_righthand":{"rotation":[0,90,0],"translation":[10,6,-4],"scale":[1,1,1]},"thirdperson_lefthand":{"rotation":[0,90,0],"translation":[10,6,12],"scale":[1,1,1]},"firstperson_righthand":{"rotation":[0,180,5],"translation":[-10,1.75,-10],"scale":[1.25,1.25,1.25]},"firstperson_lefthand":{"rotation":[0,180,5],"translation":[10,0,-10],"scale":[1.25,1.25,1.25]},"gui":{"rotation":[15,-25,-5],"translation":[2,2.3,0],"scale":[0.58,0.58,0.58]},"head":{"rotation":[0,180,0],"translation":[0,13,7],"scale":[1,1,1]},"ground":{"rotation":[0,0,0],"translation":[2,4,2],"scale":[0.25,0.25,0.25]},"fixed":{"rotation":[0,180,0],"translation":[-4.5,4.5,-5],"scale":[0.55,0.55,0.55]},"on_shelf":{"rotation":[0,0,0],"translation":[11,18.5,8.7],"scale":[1.4,1.4,1.4]}}},"fiche":{"nom":"\u00c9gide de l'Abysse","ensemble":"Abyssal","rarete":"epique","description":"Skin de bouclier : une \u00e9caille d'os noir bomb\u00e9e, arm\u00e9e de deux cornes en crochet et d'une griffe \u00e0 pointe verte au centre. Ses veines creus\u00e9es br\u00fblent d'un vert acide, plus fort quand tu l\u00e8ves l'\u00e9gide et quand un coup te touche.","lore":"L'Abysse a ses gardiens, des b\u00eates cuirass\u00e9es que la lueur verte n'a jamais rong\u00e9es. Les Chasseurs ont appris \u00e0 les vaincre par le flanc, puis \u00e0 porter leurs \u00e9cailles. Une \u00c9gide ne se forge pas : elle se gagne, et ses veines gardent la faim de la b\u00eate. Chaque coup qu'elle encaisse les rallume, comme un c\u0153ur qui refuse de s'\u00e9teindre."}}}}