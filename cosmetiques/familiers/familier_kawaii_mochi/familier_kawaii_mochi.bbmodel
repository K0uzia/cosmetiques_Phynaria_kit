.land_speed*0.12,0.4,1.4)"}],"time":0.6}]}}}],"unhandled_root_fields":{"phynaria":{"version":1,"familier":{"mode":"vol","distance":2,"vitesse":1,"hauteur":1.6},"fiche":{"nom":"Mochi nuage","ensemble":"Kawaii","rarete":"legendaire","description":"Petit nuage dodu \u00e0 visage kawaii qui suit le joueur en volant pr\u00e8s de son \u00e9paule. Vivant et expressif : il rebondit, fait des pirouettes, s'endort en nuage plat, grisonne sous la pluie, fait un arc-en-ciel quand il est content et un petit orage boudeur quand on blesse son ma\u00eetre.","lore":"Il s'est d\u00e9tach\u00e9 d'un grand nuage un jour de f\u00eate et n'a jamais voulu retourner l\u00e0-haut. Il n'a pas de poids, pas d'\u00e2ge et pas vraiment de nom ; il r\u00e9pond quand m\u00eame \u00e0 tous ceux qu'on lui donne."},"particules":{"coeur":{"quand":"toujours","nombre":2,"duree":1,"mouvement":"monte","au_sol":"disparait","rendu":"opaque","sens":"camera","fin_de_vie":"retrecit","depart":"poussee","dispersion":45,"elan":100,"variation":"legere","rafale":"aucune","limite":64},"goutte":{"quand":"toujours","nombre":2,"duree":1,"mouvement":"lourde","au_sol":"disparait","rendu":"translucide","sens":"camera","fin_de_vie":"fondu","depart":"poussee","dispersion":15,"elan":100,"variation":"legere","rafale":"aucune","limite":64}}}}}