aisse.","lore":"On dit que le premier est n\u00e9 d'un flocon tomb\u00e9 sur la truffe d'un renard endormi. Ceux d'aujourd'hui choisissent leur compagnon au premier regard et ne le quittent plus. Leur pelage ne mouille jamais, mais ils d\u00e9testent la pluie quand m\u00eame."},"particules":{"brume":{"quand":"toujours","nombre":2,"duree":1,"mouvement":"legere","au_sol":"disparait","rendu":"translucide","sens":"camera","fin_de_vie":"fondu","depart":"poussee","dispersion":45,"elan":100,"variation":"forte","rafale":"aucune","limite":64},"scintille":{"quand":"toujours","nombre":0.5,"duree":1,"mouvement":"monte","au_sol":"disparait","rendu":"opaque","sens":"camera","fin_de_vie":"retrecit","depart":"poussee","dispersion":45,"elan":100,"variation":"legere","rafale":"aucune","limite":64},"souffle":{"quand":"toujours","nombre":4,"duree":1,"mouvement":"flotte","au_sol":"disparait","rendu":"translucide","sens":"camera","fin_de_vie":"fondu","depart":"rapide","dispersion":15,"elan":40,"variation":"legere","rafale":"aucune","limite":64}}}}}