es":[{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"0.0"}],"time":0},{"channel":"rotation","data_points":[{"x":"0.0","y":"360.0","z":"0.0"}],"time":2.0},{"channel":"scale","data_points":[{"x":"math.lerp(0.7, 1.5, math.mod(q.anim_time, 2) / 2)","y":"1","z":"math.lerp(0.7, 1.5, math.mod(q.anim_time, 2) / 2)"}],"time":0}]}}},{"uuid":"e9e86647-4253-4ac6-818f-10610e4617a1","name":"overlay_ambiance","loop":"loop","override":false,"length":1.0,"snapping":24,"selected":false,"animators":{"a56b8aea-7bc7-4cae-bb88-e236810dfcfb":{"name":"ctrl_teinte","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.22 * v.pluie","y":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.17 * v.pluie","z":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.06 * v.pluie"}],"time":0}]},"ceae0f87-9158-43d8-b4ff-289331f019ca":{"name":"ctrl_lumiere","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); 0.3 + 0.5 * math.clamp((0.27 - math.abs(q.time_of_day - 0.5)) * 6, 0, 1) + 0.3 * v.pluie","y":"0","z":"0"}],"time":0}]}}}],"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"Ailes Steampunk","ensemble":"Steampunk","rarete":"legendaire","description":"Ailes \u00e0 vapeur articul\u00e9es en laiton, cuivre et acier sombre : neuf lames d'\u00e9ventail qui se d\u00e9ploient cran par cran, engrenages qui s'entra\u00eenent au coude et au poignet, v\u00e9rin \u00e0 tige coulissante. Mouvement m\u00e9canique saccad\u00e9, avec vapeur \u00e0 la d\u00e9charge.","lore":"Le chef d'atelier les a construites pour prouver qu'une machine pouvait voler sans tricher : chaque lame est entra\u00een\u00e9e par un engrenage, chaque engrenage par la vapeur. Elles mettent un instant \u00e0 se r\u00e9gler avant de s'ouvrir, comme une montre qu'on remonte."},"particules":{"vapeur":{"quand":"toujours","nombre":1,"duree":1,"mouvement":"monte","au_sol":"pose","rendu":"translucide","sens":"camera","fin_de_vie":"fondu","depart":"lent","dispersion":15,"elan":40,"variation":"forte","rafale":"aucune","limite":64}}}}}