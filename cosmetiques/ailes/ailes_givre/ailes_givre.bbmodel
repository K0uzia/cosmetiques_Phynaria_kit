me":0.592},{"channel":"scale","data_points":[{"x":"0.11","y":"0.11","z":"0.11"}],"time":0.762},{"channel":"scale","data_points":[{"x":"0.0","y":"0.0","z":"0.0"}],"time":0.846},{"channel":"scale","data_points":[{"x":"0.0","y":"0.0","z":"0.0"}],"time":2.2}]}}}],"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"Ailes de givre","ensemble":"Givre","rarete":"legendaire","description":"Longs cristaux de glace taill\u00e9s, bleu nuit, cyan et blanc givr\u00e9, port\u00e9s par un squelette d'os de givre clair ; la glace est translucide et garde sa lumi\u00e8re bleue int\u00e9rieure. Anim\u00e9es dans les douze \u00e9tats ; des flocons tombent des ailes.","lore":"Elles ont pouss\u00e9 sur le dos d'une gardienne qui s'\u00e9tait endormie dans le C\u0153ur d'Hiver, cristal apr\u00e8s cristal, sans qu'elle le sente. Elles ne fondent pas au soleil. Quand elles battent, l'air se fige un instant et l'on entend la glace chanter."},"particules":{"givre":{"quand":"vol","nombre":2,"duree":3,"mouvement":"legere","au_sol":"pose","rendu":"opaque","sens":"libre","fin_de_vie":"retrecit","depart":"poussee","dispersion":15,"elan":40,"variation":"legere","rafale":"aucune","limite":64}}}}}