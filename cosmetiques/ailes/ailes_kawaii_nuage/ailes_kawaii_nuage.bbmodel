:"rotation","data_points":[{"x":"0.0","y":"0.0","z":"-0.52"}],"time":0.267},{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"-1.63"}],"time":0.333},{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"-6.28"}],"time":0.533},{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"-8.15"}],"time":0.667},{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"-8.2"}],"time":1.6}]},"7bd1d65a-c451-4c37-b499-3571395add5c":{"name":"p4_r","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"0.0"}],"time":0.0},{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"-0.23"}],"time":0.267},{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"-1.22"}],"time":0.333},{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"-8.04"}],"time":0.6},{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"-9.11"}],"time":0.667},{"channel":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"-9.4"}],"time":1.6}]}}}],"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"Ailes Nuage Guimauve","ensemble":"Kawaii","rarete":"epique","description":"Ailes de ch\u00e9rubin-guimauve : un petit nuage dodu pos\u00e9 sur chaque bras, d'o\u00f9 pendent des plumes rondes rose framboise et lilas bien rang\u00e9es. Elles battent avec des rebonds moelleux, s'\u00e9tirent au repos et sortent d'un \u00ab plop \u00bb de nuage \u00e0 l'\u00e9quipement.","lore":"Au pays de Nuage Guimauve, les ailes ne servent pas \u00e0 voler tr\u00e8s haut, seulement assez pour atteindre l'\u00e9tag\u00e8re des bonbons. Celles-ci poussent sur un nuage du matin, encore ti\u00e8de, que l'on a gard\u00e9 au chaud sous l'oreiller. Elles sentent un peu la vanille."}}}}