el":"rotation","data_points":[{"x":"0.0","y":"0.0","z":"0.0"}],"time":1.5}]},"effects":{"name":"Effects","type":"effect","keyframes":[{"channel":"sound","data_points":[{"effect":"block.fire.extinguish","file":""}],"time":0.66}]}}},{"uuid":"9dd85ce0-fee4-4090-afff-d05a32ebc19e","name":"overlay_ambiance","loop":"loop","override":false,"length":1.0,"snapping":24,"selected":false,"animators":{"39226bb6-000b-4e90-8668-26358bf33ef1":{"name":"ctrl_teinte","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.22 * v.pluie","y":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.17 * v.pluie","z":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.06 * v.pluie"}],"time":0}]},"c7cb4b65-f30f-4a1c-b854-9f9b2175bea3":{"name":"ctrl_lumiere","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); 0.3 + 0.5 * math.clamp((0.27 - math.abs(q.time_of_day - 0.5)) * 6, 0, 1) + 0.3 * v.pluie","y":"0","z":"0"}],"time":0}]}}}],"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"Haut-de-forme Steampunk","ensemble":"Steampunk","rarete":"rare","description":"Haut-de-forme de feutre brun \u00e0 ruban de cuir, pos\u00e9 sur une petite chaudi\u00e8re : foyer rougeoyant au dos, manom\u00e8tre, chemin\u00e9e qui l\u00e2che sa vapeur. En sneak, un moteur \u00e0 vapeur bascule les lunettes ambre devant les yeux, puis deux loupes d'horloger pivotent devant le verre droit.","lore":"Aucun ma\u00eetre de l'Atelier de laiton ne sort sans son haut-de-forme : le foyer du dos tient la chaudi\u00e8re au chaud, et le petit moteur du bord abaisse les lunettes d\u00e8s qu'il faut regarder de pr\u00e8s. Quand l'aiguille du manom\u00e8tre monte trop, la chemin\u00e9e siffle, et tout l'atelier sait qu'il vaut mieux se taire."},"particules":{"mc_white_smoke":{"quand":"toujours","nombre":2,"depart":"lent","dispersion":15,"rafale":"aucune","limite":64}}}}}