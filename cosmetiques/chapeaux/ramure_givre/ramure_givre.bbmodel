:1.0},{"channel":"scale","data_points":[{"x":"1.0","y":"1.0","z":"1.0"}],"time":0.0},{"channel":"scale","data_points":[{"x":"1.25","y":"1.25","z":"1.25"}],"time":0.125},{"channel":"scale","data_points":[{"x":"0.75","y":"0.75","z":"0.75"}],"time":0.375},{"channel":"scale","data_points":[{"x":"1.25","y":"1.25","z":"1.25"}],"time":0.625},{"channel":"scale","data_points":[{"x":"0.75","y":"0.75","z":"0.75"}],"time":0.875},{"channel":"scale","data_points":[{"x":"1.0","y":"1.0","z":"1.0"}],"time":1.0}]}}}],"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"Ramure de givre","ensemble":"Givre","rarete":"epique","description":"Deux bois de cerf en glace taill\u00e9e qui poussent sur le dessus de la t\u00eate : merrain en lyre \u00e0 c\u0153ur cyan lumineux, n\u0153uds de givre et andouillers pointus. \u00c0 l'\u00e9quipement, la ramure pousse tron\u00e7on par tron\u00e7on ; ses pointes fr\u00e9missent au pas et scintillent.","lore":"Au C\u0153ur d'Hiver, les grands cerfs blancs perdent leurs bois chaque printemps, et la glace les reprend. Les gardiens qui en sont jug\u00e9s dignes voient la ramure repousser sur leur propre t\u00eate, un andouiller apr\u00e8s l'autre, jamais deux fois pareille. Elle garde en son c\u0153ur la lumi\u00e8re bleue du Nord."},"particules":{"scintille":{"quand":"toujours","nombre":0.5,"duree":1,"mouvement":"flotte","au_sol":"pose","rendu":"translucide","sens":"camera","fin_de_vie":"fondu","depart":"poussee","dispersion":15,"elan":100,"variation":"legere","rafale":"aucune","limite":64}}}}}