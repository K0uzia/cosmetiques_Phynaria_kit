7efb-38de-41d8-bc49-919db4e839a7":{"name":"ctrl_teinte","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.22 * v.pluie","y":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.17 * v.pluie","z":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.06 * v.pluie"}],"time":0}]},"e1dd37e7-30af-440e-9bd1-8a6b09c97172":{"name":"ctrl_lumiere","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); 0.3 + 0.5 * math.clamp((0.27 - math.abs(q.time_of_day - 0.5)) * 6, 0, 1) + 0.3 * v.pluie","y":"0","z":"0"}],"time":0}]}}}],"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"Aura du Brasier","ensemble":"Brasier","rarete":"epique","description":"Une chaleur de braise autour du joueur : liser\u00e9 or et orange derri\u00e8re la silhouette, filets de chaleur qui ondulent et montent, braises qui s'\u00e9l\u00e8vent et refroidissent, sol fendu qui rougeoie. S'allume du sol vers la t\u00eate.","lore":"Ce n'est pas un incendie : rien n'y br\u00fble. C'est la chaleur d'un combattant qui ne s'\u00e9teint jamais tout \u00e0 fait, assez forte pour fendre la pierre sous ses pieds et faire trembler l'air au-dessus de lui. Les braises qui s'en \u00e9chappent montent, p\u00e2lissent, et retombent en cendre bien loin de lui."},"particules":{"braise":{"quand":"toujours","nombre":2,"duree":1,"mouvement":"monte","au_sol":"pose","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"lent","dispersion":45,"elan":100,"variation":"legere","rafale":"aucune","limite":64}}}}}