time":0}]},"e568d4a0-951c-4587-bb43-e47c04c7815e":{"name":"ctrl_teinte","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.22 * v.pluie","y":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.17 * v.pluie","z":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.06 * v.pluie"}],"time":0}]},"01b1b530-10c8-4982-8575-c36cb197ddae":{"name":"ctrl_lumiere","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); 0.3 + 0.5 * math.clamp((0.27 - math.abs(q.time_of_day - 0.5)) * 6, 0, 1) + 0.3 * v.pluie","y":"0","z":"0"}],"time":0}]}}}],"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"Aura abyssale","ensemble":"Abyssal","rarete":"epique","description":"Une lumi\u00e8re violette qui \u00e9pouse la silhouette, une couronne de crocs vert acide derri\u00e8re la t\u00eate, des veines de lumi\u00e8re qui montent dans le dos et un sceau qui tourne au sol. \u00c0 l'\u00e9quipement, le sceau s'ouvre puis l'aura monte des pieds \u00e0 la t\u00eate.","lore":"Chaque d\u00e9mon abattu laisse au chasseur une marque qui ne s'efface pas. \u00c0 force, elles se sont li\u00e9es en un sceau qui le suit \u00e0 chaque pas et en une couronne de crocs qu'il n'a jamais demand\u00e9e. L'Abysse le reconna\u00eet de loin ; c'est voulu."},"particules":{"braise":{"quand":"toujours","nombre":1,"duree":1,"mouvement":"monte","au_sol":"pose","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"lent","dispersion":15,"elan":100,"variation":"legere","rafale":"aucune","limite":64}}}}}