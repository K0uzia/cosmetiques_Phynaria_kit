re":0.5,"duree":3,"mouvement":"monte","au_sol":"pose","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"lent","dispersion":15,"elan":100,"variation":"legere","rafale":"aucune","limite":64},"etincelle":{"quand":"toujours","nombre":0.5,"duree":1,"mouvement":"monte","au_sol":"pose","rendu":"lumineux","sens":"camera","fin_de_vie":"fondu","depart":"lent","dispersion":15,"elan":100,"variation":"legere","rafale":"aucune","limite":64}}}}}