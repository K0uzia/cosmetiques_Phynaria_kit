e","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.22 * v.pluie","y":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.17 * v.pluie","z":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.06 * v.pluie"}],"time":0}]},"a066be64-0bc0-4e66-8e75-14833b0a6977":{"name":"ctrl_lumiere","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); 0.3 + 0.5 * math.clamp((0.27 - math.abs(q.time_of_day - 0.5)) * 6, 0, 1) + 0.3 * v.pluie","y":"0","z":"0"}],"time":0}]}}}],"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"Queue abyssale","ensemble":"Abyssal","rarete":"rare","description":"Queue-fouet lisse et effil\u00e9e, parcourue d'une veine vert acide, cercl\u00e9e d'anneaux de cuir \u00e0 clous d'os et termin\u00e9e par une fine lame en c\u0153ur. Elle ondule dans tous les \u00e9tats, du repos \u00e0 la nage.","lore":"Elle est arriv\u00e9e la deuxi\u00e8me ann\u00e9e, comme les cornes, et le chasseur a appris \u00e0 s'en servir comme d'une seconde arme. Sa lame en c\u0153ur est la seule chose douce que l'Abysse lui ait jamais donn\u00e9e."}}}}