"}],"time":2.0}]},"effects":{"name":"Effects","type":"effect","keyframes":[{"channel":"sound","data_points":[{"effect":"block.fire.extinguish","file":""}],"time":1.45}]}}},{"uuid":"83a0f140-c1d8-458c-8155-70bdf55c8d27","name":"overlay_ambiance","loop":"loop","override":false,"length":1.0,"snapping":24,"selected":false,"animators":{"edbb1002-59ef-4abf-b53d-143d8fce890b":{"name":"ctrl_teinte","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.22 * v.pluie","y":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.17 * v.pluie","z":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); -0.06 * v.pluie"}],"time":0}]},"e018c498-624a-4066-a019-4645131411db":{"name":"ctrl_lumiere","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":"v.pluie = math.lerp(v.pluie, q.is_in_rain, math.min(1, q.delta_time * 0.6)); 0.3 + 0.5 * math.clamp((0.27 - math.abs(q.time_of_day - 0.5)) * 6, 0, 1) + 0.3 * v.pluie","y":"0","z":"0"}],"time":0}]}}}],"unhandled_root_fields":{"phynaria":{"version":1,"fiche":{"nom":"Queue Steampunk","ensemble":"Steampunk","rarete":"commun","description":"Colonne de neuf vert\u00e8bres de laiton sur rotules d'acier, tir\u00e9e par quatre c\u00e2bles de cuivre qu'enroulent les tambours du bo\u00eetier, aid\u00e9e de deux v\u00e9rins. Elle ondule en vague, se raidit quand la pression monte, puis l\u00e2che la vapeur par la buse de son empennage.","lore":"L'Atelier de laiton cherchait o\u00f9 \u00e9vacuer la vapeur de ses machines port\u00e9es sans br\u00fbler le dos de leur porteur. Un chaudronnier a fait passer le tuyau dans une colonne articul\u00e9e, puis lui a donn\u00e9 des c\u00e2bles, des tambours et un gouvernail. Elle ne sert plus seulement d'\u00e9chappement : elle garde l'\u00e9quilibre, et elle siffle quand on la fait attendre."},"particules":{"mc_white_smoke":{"quand":"toujours","nombre":2,"depart":"lent","dispersion":15,"rafale":"aucune","limite":64}}}}}